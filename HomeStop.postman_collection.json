  },
  "item": [
    {
      "name": "Get session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Be van lépve', () => {\n  pm.response.to.have.status(200);\n  pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('email'));\n});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "",
            "variables": ""
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/get-session",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "get-session"
          ]
        }
      },
      "response": []
    },
    {
      "name": "App – get user profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('App végpont a tokennel a saját useremet adja', () => {\r\n  pm.response.to.have.status(200);\r\n  pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('email'));\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-tsr-serverFn",
            "value": "true"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "Sec-Fetch-Site",
            "value": "same-origin"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/_serverFn/3da60f48f265def6cb6346d8622d1cb8f6ad9e6571883920b0332f0222ebbfce",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "_serverFn",
            "3da60f48f265def6cb6346d8622d1cb8f6ad9e6571883920b0332f0222ebbfce"
          ]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "Cookie",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{auth_secret_183h}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// ha nincs token, belép és elmenti",
          "if (pm.collectionVariables.get('token')) return;",
          "const url = pm.collectionVariables.get('baseUrl');",
          "pm.sendRequest({",
          "  url: url + '/api/auth/sign-in/email', method: 'POST',",
          "  header: { 'Content-Type': 'application/json', 'Origin': url },",
          "  body: { mode: 'raw', raw: JSON.stringify({ email: pm.collectionVariables.get('email'), password: pm.collectionVariables.get('password') }) }",
          "}, (err, res) => pm.collectionVariables.set('token', res.cookies.get('better-auth.session_token')));"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "auth_secret_183h",
      "secret": true
    }
  ]
}